				shoulder,
				CFrame.Angles(0, 0, side * 0.4)
			)
			local forearm = limb(
				side == 1 and "RightForearm" or "LeftForearm",
				V(1.65, 3.3, 1.8),
				(elbow + handPos) / 2,
				bark,
				arm,
				elbow,
				CFrame.Angles(0, 0, side * 0.2)
			)
			oval("KnottedElbow", V(2.3, 2.1, 2.2), elbow, dark, arm)
			oval("RootPalm", V(2.3, 1.6, 1.7), handPos, bark, forearm)
			for finger = 1, 4 do
				local a = handPos + V((finger - 2.5) * 0.45, -0.5, -0.2)
				local b = a + V(side * 0.3, -1.4, -0.5)
				branch("RootDigit", a, b, 0.32, bark, forearm)
				branch("RootClaw", b, b + V(-side * 0.15, -0.3, -0.7), 0.22, ivory, forearm)
			end
			local leg = limb(
				side == 1 and "RightLeg" or "LeftLeg",
				V(2, 3.5, 2.4),
				V(side * 1.65, -4.6, 0.5),
				bark,
				torso,
				V(side * 1.7, -2.8, 0.5)
			)
			for toe = 1, 3 do
				branch(
					"ButtressToe",
					V(side * 1.65, -5.2, 0.5),
					V(side * 1.65 + (toe - 2) * 1.1, -6.5, -1.7),
					0.8,
					bark,
					leg
				)
			end
			for i = 1, 3 do
				leaf(
					"ShoulderFoliage",
					shoulder + V(side * i * 0.4, 1 + i * 0.25, 0.2),
					V(3.2, 1.6, 3.2),
					i % 2 == 0 and moss or C(98, 137, 77),
					arm,
					i * 0.8
				)
			end
		end
		head =
			limb("Head", V(3, 3.2, 2.5), V(-0.35, 5.1, -0.6), bark, torso, V(-0.2, 3.7, 0), CFrame.Angles(0, 0, -0.08))
		ornament("FaceHollow", V(2.3, 1.8, 0.25), V(-0.35, 5, -1.94), dark, head)
		for _, side in { -1, 1 } do
			leaf("HeavyBrow", V(-0.35 + side * 0.7, 5.6, -2.1), V(1.3, 0.5, 0.5), C(130, 97, 61), head, side * 0.15)
			ornament("AmberEye", V(0.5, 0.26, 0.2), V(-0.35 + side * 0.65, 5.25, -2.15), gold, head).Material =
				Enum.Material.Neon
			local points =
				{ V(side, 6.2, 0), V(side * 2.3, 8, 0.3), V(side * 3.1, 10.1, 0.7), V(side * 4.6, 11.5, 0.2) }
			for i = 1, 3 do
				branch("CrownBough", points[i], points[i + 1], 0.9 - i * 0.16, bark, head)
				local tip = points[i + 1] + V(-side * 0.6, 1.5, -0.9)
				branch("CrownFork", points[i + 1], tip, 0.32, bark, head)
				if i > 1 then
					leaf("CrownLeafFan", tip, V(3.5, 1.1, 3.2), moss, head, side * i)
				end
			end
		end
		for i = 1, 5 do
			branch(
				"RootBeard",
				V(-1.6 + i * 0.45, 4.5, -1.95),
				V(-1.8 + i * 0.5, 2.9 - (i % 2) * 0.5, -2.2),
				0.23,
				C(128, 131, 82),
				head
			)
		end
		for i = 1, 4 do
			mushroom(V(2.65, -1 + i * 1.1, 0.5), 0.65 + i * 0.12, torso, C(185, 143, 91))
		end
		oval("BackMoss", V(4.5, 4.3, 1), V(0, 1.3, 2.8), moss, torso)
	end
	-- Species-specific finishing, attached to the body part that owns it.
	if species == "Mosscap" then
		for _, side in {-1,1} do
			oval("CheekBlush", V(0.48,0.23,0.12), V(side*0.83,1.05,-1.65), C(179,130,102), head)
			branch("SatchelStrap", V(side*0.95,0.8,-0.85), V(side*0.9,-1.2,-1.05), 0.16, bark, torso)
			oval("EyeGlint", V(0.08,0.12,0.06), V(side*0.53-0.06,1.5,-1.9), ivory, head)
		end
		oval("Mouth", V(0.4,0.12,0.1), V(0,0.87,-1.68), dark, head)
		ornament("SatchelClasp", V(0.4,0.5,0.12), V(0,-0.7,-1.15), gold, torso)
	elseif species == "Thornback Stag" then
		for _, side in {-1,1} do
			oval("InnerEar", V(1.1,0.2,0.55), V(side*1.3,4.66,-2.83), ivory, head, CFrame.Angles(0,side*0.4,0))
			for i=1,4 do
				local start=V(side*0.6,1.7,1.7-i*0.8)
				branch("ThornSpine",start,start+V(side*0.28,0.9,0.35),0.18,ivory,torso)
			end
		end
		oval("ForeheadBlaze",V(0.38,1.2,0.12),V(0,4.25,-4.46),ivory,head)
	elseif species == "Hollow Sentinel" then
		for _, side in {-1,1} do
			local arm=model:FindFirstChild(side==1 and "RightArm" or "LeftArm")
			for i=1,3 do
				ornament("CarvedArmBand",V(1.42,0.15,1.62),V(side*2.8,0.75-i*0.8,0),dark,arm)
			end
			ornament("ShoulderInset",V(0.85,0.4,0.08),V(side*2.6,1.8,-1.28),gold,arm)
		end
		for i=1,3 do
			ornament("RelicGlyph",V(0.25,0.35,0.1),V(-0.6+i*0.3,2,-1.1),mint,torso).Material=Enum.Material.Neon
		end
	else
		for _, side in {-1,1} do
			local arm=model:FindFirstChild(side==1 and "RightArm" or "LeftArm")
			oval("ShoulderMossMass",V(3.5,1.2,3.4),V(side*3.2,3.5,0.3),moss,arm)
			for i=1,3 do
				local a=V(side*(0.9+i*0.55),6.8+i*0.8,0.2)
				oval("CrownLeafCluster",V(2.8,0.8,2.4),a,moss,head,CFrame.Angles(0,i*side,0))
			end
		end
		for i=1,3 do
			oval("AncientGrowthRing",V(1.1,0.35,0.2),V(0,1.5-i*0.65,-2.69),C(172,128,64),torso)
		end
	end
	-- Feet are authored relative to the root; calculate clearance from the actual rig.
	local lowest = math.huge
	for _, p in model:GetChildren() do
		if p:IsA("BasePart") and p ~= root then
			local cf = p.CFrame
			local halfY = (
				math.abs(cf.RightVector.Y) * p.Size.X
				+ math.abs(cf.UpVector.Y) * p.Size.Y
				+ math.abs(cf.LookVector.Y) * p.Size.Z
			) / 2
			lowest = math.min(lowest, p.Position.Y - halfY)
		end
	end
	local hum = Instance.new("Humanoid")
	hum.RequiresNeck = false
	hum.BreakJointsOnDeath = false
	hum.HipHeight = math.max(0, -lowest - root.Size.Y / 2)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.Parent = model
	Instance.new("Animator").Parent = hum
	model:SetAttribute("AssetStage", "AuthoredRig")
	model:SetAttribute("DesignVersion", 4)
	model.Parent = staging
end
local rs, ss = game:GetService("ReplicatedStorage"), game:GetService("ServerStorage")
local destination = rs:FindFirstChild("Mobs") or folder(rs, "Mobs")
local old = destination:FindFirstChild("Forest")
if old then
	local backups = ss:FindFirstChild("WorldGeneratorBackups") or folder(ss, "WorldGeneratorBackups")
	old.Parent = folder(backups, "ForestMobs_" .. os.date("%Y%m%d_%H%M%S"))
end
staging.Parent = destination
game:GetService("Selection"):Set({ staging })
print("Forest v4: faceted Mosscap, thorn-crowned Stag, carved Sentinel and old-growth Elderbark. Run 06 to fit spawns to these rigs.")
end

-- BEGIN 06_ForestSpawnsAndLighting.luau
do
-- Run after 04_Forest and 05_ForestMobModels, in Studio Edit mode.
assert(not game:GetService("RunService"):IsRunning(), "Stop Play before generating Forest spawns and lighting")
local RS = game:GetService("ReplicatedStorage")
local SS = game:GetService("ServerStorage")
local maps = workspace:FindFirstChild("Maps")
local map = maps and maps:FindFirstChild("Forest")
assert(map and map:IsA("Model"), "Generate Forest v4 first")
local markers = map:FindFirstChild("PlanningMarkers")
local ground = map:FindFirstChild("Ground")
local rigs = RS:FindFirstChild("Mobs") and RS.Mobs:FindFirstChild("Forest")
assert(markers and ground and rigs, "Generate the Forest map and rigs first")
local function folder(parent, name)
	local f = parent and parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end
local staging = folder(nil, "Forest")
local ray = RaycastParams.new()
ray.FilterType = Enum.RaycastFilterType.Include
ray.FilterDescendantsInstances = { ground }
-- The map owns encounter positions. Never silently move a spawn away from its
-- authored pocket: a blocked marker is an actionable authoring error.
assert(map:GetAttribute("DesignVersion") == 4, "Regenerate Forest with 04 before running 06")
local encounters = assert(map:FindFirstChild("EncounterMarkers"), "Forest encounter markers missing")
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = { map }
local installed = {}
for _, anchor in encounters:GetChildren() do
	local name = anchor:GetAttribute("Species")
	local rig = rigs:FindFirstChild(name)
	local hum = rig and rig:FindFirstChildOfClass("Humanoid")
	local root = rig and rig:FindFirstChild("HumanoidRootPart")
	assert(hum and root, "Missing Forest rig: " .. tostring(name))
	assert(rig:GetAttribute("DesignVersion") == 4, "Regenerate Forest rigs with 05 first")
	local hit = workspace:Raycast(anchor.Position + Vector3.new(0, 100, 0), Vector3.new(0, -200, 0), ray)
	assert(hit and hit.Normal.Y > 0.95 and math.abs(hit.Position.Y - anchor.Position.Y + 3) < 1,
		"Encounter must be on the glade floor: " .. anchor.Name)
	local clearance = hum.HipHeight + root.Size.Y / 2
	local boxCF, boxSize = rig:GetBoundingBox()
	local position = hit.Position + Vector3.new(0, clearance + 0.15, 0)
	local spawnCF = CFrame.new(position) * anchor.CFrame.Rotation
	for _, water in map.Water:GetChildren() do
		if water.Name == "WaterSurface" then
			local point = water.CFrame:PointToObjectSpace(position)
			assert(math.sqrt(point.Y*point.Y + point.Z*point.Z) > water.Size.Y/2 + 4,
				"Encounter intersects water: " .. anchor.Name)
		end
	end
	local localBounds = rig:GetPivot():ToObjectSpace(boxCF)
	-- Full visible silhouette, not just a small HumanoidRootPart.
	local checkCF = spawnCF * localBounds + Vector3.new(0, 0.1, 0)
	for _, obstacle in workspace:GetPartBoundsInBox(checkCF, boxSize, overlap) do
		assert(not obstacle.CanCollide or obstacle:IsDescendantOf(ground),
			"Blocked encounter " .. anchor.Name .. " by " .. obstacle:GetFullName())
	end
	for _, previous in installed do
		assert((previous.Position-position).Magnitude > 18, "Encounters too close: " .. anchor.Name)
	end
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, Vector3.one, spawnCF
	p.Anchored, p.Transparency = true, 1
	p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
	p:SetAttribute("EncounterId", anchor.Name)
	p.Parent = staging
	table.insert(installed, p)
end
assert(#installed == map:GetAttribute("EncounterCount"), "Incomplete Forest encounters")
local template = folder(nil, "Forest")
local properties = {
	ClockTime = 15.7,
	Brightness = 2.6,
	ExposureCompensation = 0.08,
	Ambient = Color3.fromRGB(84, 105, 103),
	OutdoorAmbient = Color3.fromRGB(132, 145, 123),
	ColorShift_Top = Color3.fromRGB(245, 218, 166),
	ColorShift_Bottom = Color3.fromRGB(40, 66, 57),
	EnvironmentDiffuseScale = 0.8,
	EnvironmentSpecularScale = 0.35,
	GlobalShadows = true,
	ShadowSoftness = 0.3,
	FogColor = Color3.fromRGB(145, 177, 161),
	FogStart = 160,
	FogEnd = 750,
}
for name, value in properties do
	template:SetAttribute(name, value)
end
local atmosphere = Instance.new("Atmosphere")
atmosphere.Name = "ForestHaze"
atmosphere.Density = 0.24
atmosphere.Offset = 0.15
atmosphere.Color = Color3.fromRGB(181, 208, 184)
atmosphere.Decay = Color3.fromRGB(99, 125, 117)
atmosphere.Glare = 0.18
atmosphere.Haze = 1.1
atmosphere.Parent = template
local grade = Instance.new("ColorCorrectionEffect")
grade.Name = "ForestGrade"
grade.Brightness = 0.015
grade.Contrast = 0.09
grade.Saturation = 0.025
grade.TintColor = Color3.fromRGB(255, 250, 238)
grade.Parent = template
local bloom = Instance.new("BloomEffect")
bloom.Name = "SoftLanternBloom"
bloom.Intensity = 0.12
bloom.Size = 24
bloom.Threshold = 1.35
bloom.Parent = template
local rays = Instance.new("SunRaysEffect")
rays.Name = "CanopySunlight"
rays.Intensity = 0.045
rays.Spread = 0.8
rays.Parent = template
-- Keep the authored sky, if one exists, instead of replacing it with an unrelated skybox.
local sky = game:GetService("Lighting"):FindFirstChildOfClass("Sky")
if sky then
	sky:Clone().Parent = template
end
local region = Instance.new("Part")
region.Name = "Forest"
region.Anchored = true
region.Transparency = 1
region.CanCollide = false
region.CanTouch = false
region.CanQuery = false
local cf, size = map:GetBoundingBox()
region.CFrame = cf
region.Size = size + Vector3.new(12, 100, 12)
local backup = folder(folder(SS, "WorldGeneratorBackups"), "ForestSetup_" .. os.date("%Y%m%d_%H%M%S"))
local function install(object, parent)
	local old = parent:FindFirstChild(object.Name)
	if old then
		old:SetAttribute("OriginalParent", parent:GetFullName())
		old.Parent = backup
	end
	object.Parent = parent
end
install(staging, folder(workspace, "MobSpawns"))
install(template, folder(folder(RS, "Resources"), "LightingTemplates"))
install(region, folder(workspace, "ZoneRegions"))
local destination = markers.Entry:Clone()
destination.Name = map.Name
destination.Size = Vector3.one
destination.Transparency = 1
destination.CanCollide = false
destination.CanTouch = false
destination.CanQuery = false
destination:SetAttribute("PlanningOnly", nil)
install(destination, folder(workspace, "ZoneTeleporters"))
local arena = region:Clone()
arena.Name = "Elderbark Heartgrove"
arena.CFrame = markers.Elderbark.CFrame * CFrame.new(0, 15, 0)
arena.Size = Vector3.new(112, 70, 112)
install(arena, folder(workspace, "ZoneRegions"))
local bosses = folder(nil, "Forest")
local bossMarker = staging:FindFirstChild("Elderbark"):Clone()
bossMarker.CFrame += Vector3.new(0, 14, 0)
bossMarker.Parent = bosses
install(bosses, folder(workspace, "BossRespawns"))

-- Real, restrained local illumination on the existing lanterns and shrine offerings.
for _, p in map:GetDescendants() do
	if p:IsA("BasePart") and (p.Name == "AmberGlass" or p.Name == "OfferingPearl") then
		local light = p:FindFirstChild("ForestAccent") or Instance.new("PointLight")
		light.Name = "ForestAccent"
		light.Color = p.Color
		light.Brightness = p.Name == "AmberGlass" and 1.2 or 0.35
		light.Range = p.Name == "AmberGlass" and 16 or 7
		light.Shadows = false
		light.Parent = p
	end
end
game:GetService("Selection"):Set({ staging, region })
print(
	"Forest v4: 20 checked encounters and Amberwood regional lighting saved. Run 08 to audit; sync Common before Play."
)
end

-- BEGIN 07_ForestCombatAssets.luau
do
-- Forest combat VFX and craftable weapon models. Run in Edit after 06.
assert(not game:GetService("RunService"):IsRunning(), "Stop Play before generating combat assets")
local RS, SS = game:GetService("ReplicatedStorage"), game:GetService("ServerStorage")
local V, C = Vector3.new, Color3.fromRGB
local function folder(parent, name)
	local f = parent:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = parent
	end
	return f
end
local resources = folder(RS, "Resources")
local destination = folder(folder(resources, "CombatVFX"), "Attacks")
local backup = folder(folder(SS, "WorldGeneratorBackups"), "ForestCombat_" .. os.date("%Y%m%d_%H%M%S"))
local function install(model, parent)
	local old = parent:FindFirstChild(model.Name)
	if old then
		old:SetAttribute("OriginalParent", parent:GetFullName())
		old.Parent = backup
	end
	model.Parent = parent
end
local function part(model, name, size, cf, color, shape)
	local p = Instance.new(shape or "Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end
local mint, gold, bark = C(137, 216, 166), C(230, 190, 110), C(106, 79, 50)
local function model(name)
	local m = Instance.new("Model")
	m.Name = name
	local anchor = part(m, "Anchor", V(0.2, 0.2, 0.2), CFrame.identity, mint)
	anchor.Transparency = 1
	m.PrimaryPart = anchor
	m:SetAttribute("Duration", 0.7)
	return m
end
local function ring(m, r, color)
	for i = 0, 23 do
		local a = i * math.pi / 12
		local p = part(
			m,
			"PulseArc",
			V(0.22, 0.16, r * 0.27),
			CFrame.new(math.cos(a) * r, 0.2, math.sin(a) * r) * CFrame.Angles(0, -a, 0),
			color
		)
		p.Material = Enum.Material.Neon
		p.Transparency = 0.3
	end
end
local function root(m, x, z, h)
	local p =
		part(m, "RootSpear", V(1.2, h, 1.6), CFrame.new(x, h / 2, z) * CFrame.Angles(-0.18, 0, 0.2), bark, "WedgePart")
	part(m, "RootTip", V(0.5, h * 0.45, 0.6), p.CFrame * CFrame.new(0, h * 0.35, 0), mint, "WedgePart")
end
for _, spec in
	{
		{ "SporeBloom", 7, mint },
		{ "SporeEcho", 10, mint },
		{ "HeartSlam", 18, gold },
		{ "ElderRoots", 6, mint },
	}
do
	local m = model(spec[1])
	ring(m, spec[2], spec[3])
	if spec[1] == "ElderRoots" then
		m:SetAttribute("RiseDistance", 4)
		for i = 0, 7 do
			local a = i * math.pi / 4
			root(m, math.cos(a) * 4, math.sin(a) * 4, 5 + (i % 2))
		end
	else
		m:SetAttribute("ExpandFrom", 0.65)
		for i = 0, 11 do
			local a = i * math.pi / 6
			local radius = spec[2] * 0.75
			local p = part(
				m,
				"SporeOrDebris",
				V(0.55, 0.8, 0.55),
				CFrame.new(math.cos(a) * radius, 1 + (i % 3) * 0.7, math.sin(a) * radius),
				spec[3],
				"WedgePart"
			)
			p.Transparency = 0.25
		end
	end
	install(m, destination)
end
local lanes = model("SentinelRoots")
lanes:SetAttribute("RiseDistance", 3)
for z = -11, 11, 5.5 do
	for _, x in { -3, 3 } do
		root(lanes, x, z, 3.5)
	end
end
install(lanes, destination)
local charge = model("AntlerRush")
for _, side in { -1, 1 } do
	for i = 1, 5 do
		local p = part(
			charge,
			"LeafWake",
			V(0.4, 0.25, 1.5),
			CFrame.new(side * (1 + i * 0.4), -1, 1 + i * 0.8) * CFrame.Angles(0, side * 0.4, 0),
			mint,
			"WedgePart"
		)
		p.Transparency = 0.35
	end
end
install(charge, destination)
for _, spec in
	{
		{ "MosscapMelee", 7, mint },
		{ "Thornback StagMelee", 8, gold },
		{ "Hollow SentinelMelee", 9, mint },
		{ "ElderbarkMelee", 20, gold },
		{ "RootSweep", 26, gold },
	}
do
	local m = model(spec[1])
	m:SetAttribute("Duration", 0.35)
	for i = 0, 10 do
		local t = i / 10
		local x = (t - 0.5) * spec[2]
		local p =
			part(m, "StrikeArc", V(spec[2] / 10, 0.25, 0.4), CFrame.new(x, 0.5, -math.sin(t * math.pi) * 2), spec[3])
		p.Material = Enum.Material.Neon
		p.Transparency = 0.2
	end
	install(m, destination)
end
-- WeaponLoader expects a Model with Handle and optional GripPoint; never anchored on equip.
local weapons = folder(resources, "Weapons")
for _, name in { "Thornwood Blade", "Heartwood Cleaver" } do
	local m = Instance.new("Model")
	m.Name = name
	local heavy = name == "Heartwood Cleaver"
	local handle = part(m, "Handle", V(0.4, 1.5, 0.4), CFrame.identity, bark)
	m.PrimaryPart = handle
	local grip = Instance.new("Attachment")
	grip.Name = "GripPoint"
	grip.Parent = handle
	m:SetAttribute("GripPosition", V(0, -0.4, 0))
	m:SetAttribute("GripOrientation", V(0, 0, 0))
	part(m, "RootGuard", V(heavy and 2.2 or 1.7, 0.4, 0.55), CFrame.new(0, 0.8, 0), gold)
	part(m, "HeartwoodBlade", V(heavy and 1.5 or 0.7, heavy and 3.5 or 3, 0.4), CFrame.new(0, 2.6, 0), bark)
	part(
		m,
		"PaleEdge",
		V(0.22, heavy and 3.6 or 3.1, 0.45),
		CFrame.new(heavy and 0.8 or 0.42, 2.6, 0),
		C(208, 216, 171),
		"WedgePart"
	)
	for i = 1, 3 do
		part(
			m,
			"Thorn",
			V(0.7, 0.65, 0.4),
			CFrame.new(-0.5, 1.4 + i * 0.8, 0) * CFrame.Angles(0, 0, -0.4),
			mint,
			"WedgePart"
		)
	end
	local seed = part(m, "HeartSeed", V(0.35, 0.6, 0.5), CFrame.new(0, 1.3, -0.05), heavy and gold or mint)
	seed.Material = Enum.Material.Neon
	for _, p in m:GetChildren() do
		if p:IsA("BasePart") then
			p.Anchored = false
			p.Massless = true
		end
	end
	install(m, weapons)
end
print(
	"Forest assets saved: 11 attack templates and 2 craftable weapons. Existing versions preserved in WorldGeneratorBackups."
)
end

-- BEGIN 08_ForestAudit.luau
do
-- Read-only Edit mode audit. Run after 04, 05, 06 (and 07 for combat assets).
assert(not game:GetService("RunService"):IsRunning(), "Stop Play before auditing Forest")
local RS = game:GetService("ReplicatedStorage")
local map = assert(workspace:FindFirstChild("Maps") and workspace.Maps:FindFirstChild("Forest"), "Forest missing")
local rigs = assert(RS:FindFirstChild("Mobs") and RS.Mobs:FindFirstChild("Forest"), "Forest rigs missing")
local spawns = assert(workspace:FindFirstChild("MobSpawns") and workspace.MobSpawns:FindFirstChild("Forest"), "Forest spawns missing")
local failures = {}
local function check(ok, message)
	if not ok then table.insert(failures, message) end
end
check(map:GetAttribute("DesignVersion") == 4, "Map is not v4")
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.FilterDescendantsInstances = {map}
local ray = RaycastParams.new()
ray.FilterType = Enum.RaycastFilterType.Include
ray.FilterDescendantsInstances = {map.Ground}
local counts, parts, collisions = {}, 0, 0
-- Verify the issue that motivated this revision: roots must enter a supporting
-- surface, including trees planted on top of the boundary cliffs.
for _, model in map.Vegetation:GetChildren() do
	local trunk = model:FindFirstChild("RootTrunk")
	if trunk then
		local foot = trunk.CFrame:PointToWorldSpace(Vector3.new(0,0,trunk.Size.Z/2))
		local hit = workspace:Raycast(foot+Vector3.new(0,3,0),Vector3.new(0,-5,0),ray)
		check(hit and hit.Position.Y-foot.Y >= 0.4, "Floating trunk: " .. model.Name)
		for _, root in model:GetChildren() do
			if root:IsA("BasePart") and root:GetAttribute("BuriedBase") then
				local bottom = root.CFrame:PointToWorldSpace(Vector3.new(0,-root.Size.Y/2,0))
				local support = workspace:Raycast(bottom+Vector3.new(0,2,0),Vector3.new(0,-4,0),ray)
				check(support and support.Position.Y-bottom.Y >= 0.15, "Exposed root base: " .. model.Name)
				local join = root.CFrame:PointToWorldSpace(Vector3.new(0,root.Size.Y/2,root.Size.Z/2))
				local localJoin = trunk.CFrame:PointToObjectSpace(join)
				check(math.abs(localJoin.X)<trunk.Size.X/2 and math.abs(localJoin.Y)<trunk.Size.Y/2,
					"Root detached from trunk: " .. model.Name)
			end
		end
	end
end
for _, object in map:GetDescendants() do
	if object:IsA("BasePart") then
		parts += 1
		if object.CanCollide then collisions += 1 end
		check(object.Anchored, "Unanchored map part: " .. object:GetFullName())
		check(not object.CanTouch, "Map decoration should not generate touch events: " .. object.Name)
	end
end
local spawnById = {}
for _, spawn in spawns:GetChildren() do
	counts[spawn.Name] = (counts[spawn.Name] or 0) + 1
	spawnById[spawn:GetAttribute("EncounterId") or "missing"] = spawn
	check(spawn.Transparency == 1 and not spawn.CanCollide and not spawn.CanQuery, "Spawn marker is physical: " .. spawn.Name)
	local rig = rigs:FindFirstChild(spawn.Name)
	check(rig ~= nil, "Missing rig: " .. spawn.Name)
	if not rig then continue end
	local hum = rig:FindFirstChildOfClass("Humanoid")
	local root = rig:FindFirstChild("HumanoidRootPart")
	local hit = workspace:Raycast(spawn.Position + Vector3.new(0,100,0), Vector3.new(0,-200,0), ray)
	check(hit ~= nil and hum ~= nil and root ~= nil, "Spawn has no floor / humanoid / root: " .. spawn.Name)
	if hit and hum and root then
		check(math.abs(spawn.Position.Y-hit.Position.Y-hum.HipHeight-root.Size.Y/2-0.15) < 0.1,
			"Rig changed or spawn is floating: " .. spawn.Name)
		local cf, size = rig:GetBoundingBox()
		for _, obstacle in workspace:GetPartBoundsInBox(spawn.CFrame * rig:GetPivot():ToObjectSpace(cf), size, overlap) do
			check(not obstacle.CanCollide or obstacle:IsDescendantOf(map.Ground),
				"Spawn overlaps " .. obstacle:GetFullName() .. ": " .. spawn.Name)
		end
	end
	for _, water in map.Water:GetChildren() do
		if water.Name == "WaterSurface" then
			local p = water.CFrame:PointToObjectSpace(spawn.Position)
			check(math.sqrt(p.Y*p.Y+p.Z*p.Z) > water.Size.Y/2+4, "Spawn in water: " .. spawn.Name)
		end
	end
end
for species, expected in {Mosscap=8, ["Thornback Stag"]=6, ["Hollow Sentinel"]=5, Elderbark=1} do
	check(counts[species] == expected, "Incorrect spawn count for " .. species)
end
for _, anchor in map.EncounterMarkers:GetChildren() do
	local spawn = spawnById[anchor.Name]
	check(spawn ~= nil, "Missing encounter: " .. anchor.Name)
	if spawn then
		local delta = anchor.Position-spawn.Position
		check(Vector3.new(delta.X,0,delta.Z).Magnitude < 0.05, "Encounter moved independently: " .. anchor.Name)
	end
end
-- Check a continuous player-sized corridor through every authored trail segment.
-- Ignore intentional underlying floor; bridge/ramp geometry is audited separately in Play.
for _, trail in map.Paths:GetDescendants() do
	if trail:IsA("BasePart") and trail.Name == "PackedEarth" then
		local cf = trail.CFrame + Vector3.new(0,3,0)
		for _, obstacle in workspace:GetPartBoundsInBox(cf, Vector3.new(5,5,trail.Size.Z), overlap) do
			check(not obstacle.CanCollide or obstacle:GetAttribute("WalkableRamp"), "Trail obstructed by " .. obstacle:GetFullName())
		end
		for _, water in map.Water:GetChildren() do
			if water.Name == "WaterSurface" then
				local p = water.CFrame:PointToObjectSpace(trail.Position)
				check(math.sqrt(p.Y*p.Y+p.Z*p.Z) > water.Size.Y/2+2.5, "Trail enters water: " .. trail.Parent.Name)
			end
		end
	end
end
for _, rig in rigs:GetChildren() do
	local root = rig:FindFirstChild("HumanoidRootPart")
	check(root ~= nil and rig.PrimaryPart == root, "Invalid rig pivot: " .. rig.Name)
	check(rig:GetAttribute("DesignVersion") == 4, "Old rig: " .. rig.Name)
	local connected = {[root]=true}
	local joints = {}
	for _, object in rig:GetDescendants() do
		if object:IsA("Motor6D") or object:IsA("WeldConstraint") then
			check(object.Part0 ~= nil and object.Part1 ~= nil, "Broken joint: " .. rig.Name .. "/" .. object.Name)
			table.insert(joints,object)
		end
	end
	for _=1,#joints do
		local changed = false
		for _, joint in joints do
			if connected[joint.Part0] and not connected[joint.Part1] then connected[joint.Part1]=true; changed=true end
		end
		if not changed then break end
	end
	for _, object in rig:GetDescendants() do
		if object:IsA("BasePart") then
			check(connected[object], "Detached rig detail: " .. rig.Name .. "/" .. object.Name)
			check(not object.Anchored, "Anchored rig detail: " .. rig.Name .. "/" .. object.Name)
			check(object == root or (object.Massless and not object.CanCollide), "Physical ornament: " .. object.Name)
		end
	end
end
local resources = RS:FindFirstChild("Resources")
local templates = resources and resources:FindFirstChild("LightingTemplates")
check(templates and templates:FindFirstChild("Forest") ~= nil, "Lighting template missing")
check(workspace.ZoneRegions:FindFirstChild("Forest") ~= nil, "Forest lighting region missing")
check(workspace.ZoneRegions:FindFirstChild("Elderbark Heartgrove") ~= nil, "Boss arena missing")
check(workspace.ZoneTeleporters:FindFirstChild("Forest") ~= nil, "Teleport destination missing")
print(string.format("Forest audit: %d map parts, %d colliders, %d failures", parts, collisions, #failures))
for _, message in failures do warn(message) end
assert(#failures == 0, "Forest audit failed. Fix the reported geometry before Play.")
print("Static Forest audit passed. Still playtest traversal, pursuit, skills, lighting transitions and respawn.")
end

print("Forest v4 installation and static audit complete. Save the place and sync Common before Play.")
