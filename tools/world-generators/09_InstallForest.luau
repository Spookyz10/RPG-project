		oval("HeartHollow", V(2.7, 3.6, 0.5), V(0, 0.5, -2), dark, torso)
		local heart = oval("HeartSeed", V(1.2, 2, 0.6), V(0, 0.4, -2.35), gold, torso)
		heart.Material = Enum.Material.Neon
		for _, side in { -1, 1 } do
